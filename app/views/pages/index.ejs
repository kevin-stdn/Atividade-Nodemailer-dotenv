<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário de Contato</title>
    <style>
        .error { color: red; font-size: 14px; margin-top: 5px; }
        .success { color: green; font-weight: bold; margin-bottom: 15px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Fale Conosco</h2>

        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <p class="success">E-mail enviado com sucesso!</p>
        <% } %>

        <form action="/enviar" method="POST">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" value="<%= typeof oldData !== 'undefined' ? oldData.nome : '' %>">
            <% if (typeof errors !== 'undefined' && errors.nome) { %>
                <div class="error"><%= errors.nome.msg %></div>
            <% } %>

            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" value="<%= typeof oldData !== 'undefined' ? oldData.email : '' %>">
            <% if (typeof errors !== 'undefined' && errors.email) { %>
                <div class="error"><div class="error"><%= errors.email.msg %></div></div>
            <% } %>

            <label for="telefone">Telefone:</label>
            <input type="text" id="telefone" name="telefone" value="<%= typeof oldData !== 'undefined' ? oldData.telefone : '' %>">

            <label for="assunto">Assunto:</label>
            <input type="text" id="assunto" name="assunto" value="<%= typeof oldData !== 'undefined' ? oldData.assunto : '' %>">
            <% if (typeof errors !== 'undefined' && errors.assunto) { %>
                <div class="error"><%= errors.assunto.msg %></div>
            <% } %>

            <label for="mensagem">Mensagem:</label>
            <textarea id="mensagem" name="mensagem" rows="4"><%= typeof oldData !== 'undefined' ? oldData.mensagem : '' %></textarea>
            <% if (typeof errors !== 'undefined' && errors.mensagem) { %>
                <div class="error"><%= errors.mensagem.msg %></div>
            <% } %>

            <button type="submit">Enviar</button>
        </form>
    </div>
</body>
</html>